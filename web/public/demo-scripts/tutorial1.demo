demo Drag
  say !
  carrycsv workspace
  wait component:caseTable 10s
  beat 1.6
  revert
  say ?

demo MakeGraph
  say !
  goto toolbar:graph
  peer toolbar:graph
  tap toolbar:graph
  wait component:graph 8s
  beat 1.4
  revert
  say ?

demo MoveComponent
  say !
  peer titleBar:graph
  drag titleBar:graph -> workspace teaching
  wait componentMoved 8s
  beat 1.4
  revert
  say ?

demo AssignAttribute
  say !
  peer pill:Mass
  drag pill:Mass -> axisDrop:bottom teaching
  wait graphX:Mass 8s
  beat 1.6
  revert
  say ?

demo SecondAttribute
  say !
  peer pill:Sleep
  drag pill:Sleep -> axisDrop:left teaching
  wait graphY:Sleep 8s
  beat 1.6
  revert
  say ?
